# Neural Fabric autonomous loop - copy to .env (never commit .env)
# Standalone system: direct provider HTTPS APIs. No IDE or harness needed.
# Explicit per-role credentials take precedence over shared OPENAI_* values.

# --- Manager primary: Nemotron 3 Ultra free (OpenRouter) - MANAGER ONLY ---
# Constrained free endpoint: one coherent work unit per call, capped context,
# gentle retries (Retry-After + jitter). Never use as worker.
MANAGER_API_KEY=
MANAGER_BASE_URL=https://openrouter.ai/api/v1
MANAGER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
MANAGER_DECISION_CHARS=4000
MANAGER_REPORT_CHARS=6000
MANAGER_EVIDENCE_CHARS=8000

# --- Manager fallback: Kimi K3 (NVIDIA) - MANAGER ONLY ---
MANAGER_FALLBACK_ENABLED=true
MANAGER_FALLBACK_API_KEY=
MANAGER_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
MANAGER_FALLBACK_MODEL=moonshotai/kimi-k3

# --- Worker primary: AGY headless CLI, Gemini 3.8 Flash High - EXECUTOR ONLY ---
# No credentials here: AGY uses your local Antigravity session.
# Flash High is the explicit user choice (capability over token savings).
AGY_ENABLED=true
AGY_COMMAND=agy
AGY_MODEL=gemini-3.8-flash-high
AGY_MODE=accept-edits
AGY_EFFORT=high
AGY_TIMEOUT_S=360
# User-authorized on this machine: AGY runs with --dangerously-skip-permissions
# (AGY subprocess only; loop git/scope/evidence protections stay in force).
AGY_DANGEROUSLY_SKIP_PERMISSIONS=true

# --- Worker fallback 1: Nemotron 3 Super (OpenRouter) - EXECUTOR ONLY ---
WORKER_API_KEY=
WORKER_BASE_URL=https://openrouter.ai/api/v1
WORKER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Worker fallback 2: DeepSeek V4 Flash (NVIDIA) - EXECUTOR ONLY ---
WORKER_BACKUP_API_KEY=
WORKER_BACKUP_BASE_URL=https://integrate.api.nvidia.com/v1
WORKER_BACKUP_MODEL=deepseek-ai/deepseek-v4-flash-0731

# --- Optional shared credentials (last resort for any missing *_API_KEY) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- Independent tester layer (manager -> builder -> tester -> manager) ---
# opencode = headless `opencode run` (read-only, never --auto);
# api = adversarial review via manager-fallback provider (review only);
# off = deterministic gates only (LLM verdict recorded INCONCLUSIVE).
TESTER_BACKEND=opencode
TESTER_TIMEOUT_S=300
TESTER_MODEL=
# Stagnation/drift: repeated tasks or evidence silence forces REPLAN.
STAGNATION_REPEAT=3
STAGNATION_WINDOW=6

# --- Loop safety limits ---
MAX_ITERATIONS=10
MAX_TOOL_STEPS=12
MAX_FAILURES=3
MAX_API_FAILURES=5
# Worker execution budget per coherent work unit (prevents runaway loops;
# breaching any budget yields a partial report for the manager to review)
WORKER_MAX_TOOL_CALLS=50
WORKER_TASK_TIMEOUT_SECONDS=2700
# Per-attempt model HTTP timeout / transient retries. Fail-slow providers are
# the dominant stall: keep bounded and fail fast (retry waits are logged).
# Short validation recipe: REQUEST_TIMEOUT_S=30 REQUEST_RETRIES=1
REQUEST_TIMEOUT_S=120
REQUEST_RETRIES=3
# Absolute session budget in hours (0 disables the deadline).
# The deadline is set once and NEVER reset by --resume.
SESSION_HOURS=24
STATE_DIR=.agent_loop
